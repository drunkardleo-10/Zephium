<!doctype html><meta charset="utf-8"><style>html,body{margin:0;width:220px;height:44px}button{border:0;width:220px;height:44px}</style><button id="fill" type="button">Fill saved login</button><script>(()=>{const nonce="__ZEPHIUM_CREDENTIAL_NONCE__";const button=document.getElementById("fill");button.addEventListener("click",event=>parent.postMessage({kind:"zephium-credential-inline-selection-v1",nonce,credentialId:"fixture-login-v1",trusted:event.isTrusted},"*"),{once:true});parent.postMessage({kind:"zephium-credential-inline-ready-v1",nonce},"*")})()</script>
