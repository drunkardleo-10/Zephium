[
  {"label":"load diagnostic", "load":"crates/zephium-webext-windows/fixtures/diagnostic"},
  {"list":true},
  {"navigate":"$ORIGIN/first"},
  {"view":"tab2"},
  {"in":"tab2","navigate":"$DENIED/second"},
  {"sleep":1500},
  {"label":"allowed origin content and worker", "eval":"return {url:location.href, data:{...document.documentElement.dataset}}"},
  {"label":"denied origin content", "in":"tab2","eval":"return {url:location.href, data:{...document.documentElement.dataset}}"},
  {"view":"popup"},
  {"in":"popup","popup":true},
  {"sleep":1500},
  {"label":"popup and worker snapshot", "in":"popup","eval":"return {url:location.href,body:document.body.innerText,snapshot:await chrome.runtime.sendMessage({op:'snapshot'})}"},
  {"label":"action state setters", "in":"popup","eval":"return await chrome.runtime.sendMessage({op:'action'})"},
  {"label":"action state getters", "in":"popup","eval":"return await chrome.runtime.sendMessage({op:'snapshot'})"},
  {"label":"script targeting and permission deny", "in":"popup","eval":"const tabs=await chrome.tabs.query({}); return await Promise.all(tabs.map(async tab=>({tab,result:await chrome.runtime.sendMessage({op:'inject',tabId:tab.id})})))"},
  {"label":"worker fetch denied origin", "in":"popup","eval":"return await chrome.runtime.sendMessage({op:'fetch',url:'$DENIED/second'})"},
  {"label":"permissions request without gesture", "in":"popup","eval":"try{return {granted:await chrome.permissions.request({origins:['http://localhost/*']})}}catch(e){return {error:String(e)}}"},
  {"view":"work-selected"},
  {"in":"work-selected","navigate":"$ORIGIN/work"},
  {"view":"work-isolated","profile":"agent-lab"},
  {"in":"work-isolated","navigate":"$ORIGIN/work"},
  {"sleep":1500},
  {"label":"hidden selected-profile Work topology", "in":"work-selected","eval":"return {url:location.href,data:{...document.documentElement.dataset}}"},
  {"label":"separate-profile Work topology", "in":"work-isolated","eval":"return {url:location.href,data:{...document.documentElement.dataset}}"},
  {"in":"work-isolated","list":true},
  {"label":"tabs after hidden contexts", "in":"popup","eval":"return await chrome.runtime.sendMessage({op:'snapshot'})"},
  {"label":"targets", "cdp":"Target.getTargets"}
]
