{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zephium",
  "version": "0.1.0",
  "identifier": "app.zephium",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frame dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../frame build",
    "frontendDist": "../frame/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Zephium",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
