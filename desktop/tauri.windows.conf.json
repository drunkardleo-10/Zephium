{
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Zephium",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
